<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>c_lan</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Utilities\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Checks\**" />
    <None Update="demo_sqlite.db" CopyToOutputDirectory="PreserveNewest" />
    <Compile Update="Forms\Form1.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\Form1.Designer.cs"><DependentUpon>Form1.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Forms\Form1.resx"><DependentUpon>Form1.cs</DependentUpon></EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

</Project>